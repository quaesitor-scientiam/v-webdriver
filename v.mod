Module {
	name: 'vebidor'
	description: 'A V implementation of W3C WebDriver + WebDriver-BiDi with a Playwright-style API: auto-waiting Locators, selector engines, web-first assertions, one-call launch(), and network interception/mocking. 100% Selenium feature parity. Plus a native mobile module driving iOS (WebDriverAgent) and Android (UiAutomator2) directly, no Appium.'
	version: '5.0.0'
	license: 'MIT'
	dependencies: []
	repo_url: 'https://github.com/quaesitor-scientiam/vebidor'
}